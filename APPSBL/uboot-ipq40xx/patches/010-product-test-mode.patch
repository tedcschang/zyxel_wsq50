Index: uboot-1.0-2012.07/common/cmd_product_test.c
===================================================================
--- /dev/null
+++ uboot-1.0-2012.07/common/cmd_product_test.c
@@ -0,0 +1,55 @@
+#include <common.h>
+#include <command.h>
+#include <linux/compiler.h>
+
+int product_test()
+{
+    char *s, *serverip;
+    char runcmd[256];
+    int product_test_mode = 0;
+    int ret = -1;
+    int count = 1;
+    char *file_name;
+    int ping_retry = 3;
+
+    s = getenv ("bootmode");
+    if ( s != NULL )
+        product_test_mode = 1;
+
+    s = getenv ("product_test_ping_retry");
+    ping_retry = s ? (int)simple_strtol(s, NULL, 10) : 3;
+
+    if (product_test_mode == 1) {
+        printf("==== PRODUCT TEST MODE ====\n");
+
+        serverip = getenv("serverip");
+        printf("Server IP is %s\n", serverip);
+        snprintf(runcmd, sizeof(runcmd), "ping %s", serverip);
+        while( (ret = run_command(runcmd, 0)) != 0) {
+            printf("return value is %d\n", ret);
+            count ++;
+            mdelay(500);
+            if(count > ping_retry) {
+                printf("can't run product test...\n");
+                return 1;
+            }
+        }
+
+        file_name = getenv("product_test_file");
+        snprintf(runcmd, sizeof(runcmd), "tftpboot 0x88000000 %s && bootm 0x88000000", (file_name != NULL)? file_name: "zyxel-uImage.itb");
+        run_command(runcmd, 0);
+    } 
+    return 0;
+}
+
+int do_product_test (cmd_tbl_t *cmdtp, int flag, int argc, char *argv[])
+{
+   return product_test();
+}
+
+U_BOOT_CMD(
+    product_test,    3,    0,    do_product_test,
+    "do the product test\n",
+    "do the product test"
+);
+
